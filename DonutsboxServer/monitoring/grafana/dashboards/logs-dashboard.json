{
  "dashboard": {
    "title": "Donutsbox Logs Dashboard",
    "tags": ["logs", "loki", "donutsbox"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
        "type": "logs",
        "title": "All Logs",
        "targets": [
          {
            "expr": "{container=~\".*\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 10},
        "type": "logs",
        "title": "Auth API Logs",
        "targets": [
          {
            "expr": "{container=\"auth-api\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 10},
        "type": "logs",
        "title": "Donutsbox API Logs",
        "targets": [
          {
            "expr": "{container=\"donutsbox-api\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 20},
        "type": "logs",
        "title": "Admin Service API Logs",
        "targets": [
          {
            "expr": "{container=\"admin-service-api\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 20},
        "type": "logs",
        "title": "File Service API Logs",
        "targets": [
          {
            "expr": "{container=\"file-service-api\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 30},
        "type": "logs",
        "title": "Frontend Logs",
        "targets": [
          {
            "expr": "{container=\"donutsbox-client\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 30},
        "type": "logs",
        "title": "Nginx Logs",
        "targets": [
          {
            "expr": "{container=\"nginx\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
        "type": "logs",
        "title": "Error Logs (All Services)",
        "targets": [
          {
            "expr": "{container=~\".*\"} |= \"Error\" or {container=~\".*\"} |= \"error\" or {container=~\".*\"} |= \"ERROR\" or {container=~\".*\"} |= \"Exception\"",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": true,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": [
        {
          "name": "container",
          "type": "query",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "query": "label_values(container)",
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          "includeAll": true,
          "multi": true,
          "refresh": 1
        }
      ]
    }
  }
}

